# Listen address
ADDR=":8080"

# Locale
YT_HL="en"
YT_GL="US"

# Timeouts
REQUEST_TIMEOUT="30s"
UPSTREAM_TIMEOUT="15s"

# Cache
CACHE_TTL="5m"
CACHE_MAX_ENTRIES="2048"

# Rate limiting
RATE_LIMIT_RPS="20"
RATE_LIMIT_BURST="40"

# Upstream retries (bounded)
MAX_RETRIES="2"

# API key auth
API_KEYS=""
REQUIRE_API_KEY="false"

# CORS origins
CORS_ORIGINS="*"

# Remote cipher service
CIPHER_SERVICE_URL=""

# PO token provider (off|manual|http)
PO_TOKEN_PROVIDER=""

# Manual PO tokens
PO_TOKEN_PLAYER=""
PO_TOKEN_SESSION=""
PO_TOKEN_MANUAL_TTL="6h"

# HTTP PO token service
PO_TOKEN_SERVICE_URL=""
PO_TOKEN_SERVICE_PATH="/tokens"
PO_TOKEN_SERVICE_GET_POT="/get_pot"
PO_TOKEN_SERVICE_AUTH=""
PO_TOKEN_SERVICE_API_KEY=""
PO_TOKEN_SERVICE_TIMEOUT="10s"
PO_TOKEN_CACHE_TTL="4m"
PO_TOKEN_CACHE_MAX="256"

# Require PO tokens for WEB clients
PO_TOKEN_REQUIRED_FOR_WEB="false"

# Expose signed stream URLs
EXPOSE_STREAM_URLS="true"

# Log level
LOG_LEVEL="info"
